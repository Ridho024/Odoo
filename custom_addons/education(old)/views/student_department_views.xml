<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="student_department_view_tree" model="ir.ui.view">
            <field name="name">student.department.view.list</field>
            <field name="model">student.department</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="academic_year"/>
                </list>
            </field>
        </record>

        <record id="student_department_action" model="ir.actions.act_window">
            <field name="name">Student Department</field>
            <field name="res_model">student.department</field>
            <field name="view_mode">list</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to Create New Department
                </p>
            </field>
        </record>

    </data>
    

</odoo>
