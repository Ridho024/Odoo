<odoo>
    <data>

        <record model="ir.ui.view" id="student_student_list_view">
            <field name="name">Student List</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" optional="show"/>
                    <field name="student_image" widget="image" class="o_list_avatar" optional="show"/>
                    <field name="nik" optional="show"/>
                    <field name="nisn" optional="show"/>
                    <field name="gender" optional="show"/> 
                    <field name="phone_number" optional="show"/> 
                    <field name="email" optional="show"/> 

                    <!-- Optional hide -->
                    <field name="birth_date" optional="hide"/> 
                    <field name="father_name" optional="hide"/>
                    <field name="mother_name" optional="hide"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="student_student_form_view">
            <field name="name">Student Form</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <form string="Student Record">
                    <sheet>
                        <group>
                            <group><h1><field name="name" placeholder="Nama Siswa" nolabel="0"/></h1></group>
                            <group><field name="student_image" widget="image" class="oe_avatar" nolabel="1"/></group>
                        </group>
                        <group>
                            <field name="class_id"/>
                        </group>
                        <notebook>
                            <page string="Data Siswa">
                                <group>
                                    <group>
                                        <field name="nik"/>
                                        <field name="nisn"/>
                                        <field name="gender"/>
                                        <field name="phone_number"/>
                                        <field name="email"/>
                                    </group>
                                    <group>
                                        <field name="birth_date"/>
                                        <field name="address"/>
                                        <field name="postcal_code"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Data Orangtua">
                                <group>
                                    <group string="Data Ayah">
                                        <field name="father_name"/>
                                        <field name="father_nik"/>
                                        <field name="father_phone_number"/>
                                        <field name="father_email"/>
                                    </group>
                                    <group string="Data Ibu">
                                        <field name="mother_name"/>
                                        <field name="mother_nik"/>
                                        <field name="mother_phone_number"/>
                                        <field name="mother_email"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Riwayat Pendidikan">
                                <field name="education_ids">
                                    <list>
                                        <field name="grade" />
                                        <field name="name" />
                                        <field name="school_type" />
                                        <field name="graduation_year" />
                                        <field name="sertification" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="student_student_action">
            <field name="name">Student</field>
            <field name="res_model">student.student</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to Create New Student Record
                </p>
            </field>
        </record>
        
    </data>
</odoo>