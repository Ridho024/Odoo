<odoo>
  <data>

    <!-- List -->
    <record model="ir.ui.view" id="student_class_list_view">
        <field name="name">Student Class List View</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="grade"/>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="department"/>
                <field name="academic_year"/>
                <field name="total_student"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record model="ir.ui.view" id="student_class_form_view">
        <field name="name">Student Class Form View</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="grade"/>
                        <field name="teacher_id"/>
                        <field name="department"/>
                        <field name="academic_year"/>
                        <field name="total_student"/>
                    </group>
                    <notebook>
                        <page string="Siswa Kelas">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="student_image" widget="image" class="o_list_avatar"/>
                                    <field name="nik"/>
                                    <field name="nisn"/>
                                    <field name="gender"/>
                                    <field name="phone_number"/>
                                    <field name="email"/>
                                    <button name="action_student_detail" type="object" class="btn-primary" icon="fa-eye"/>
                                </list>
                            </field>
                        </page>
                        <page string="Jadwal Pelajaran">
                            <field name="schedule_ids">
                                <list>
                                    <field name="name" />
                                    <field name="day" />
                                    <field name="teacher_id" />
                                    <field name="start_time" />
                                    <field name="end_time" />
                                    <field name="duration" />
                                    <field name="classroom_id" />
                                </list>
                            </field>
                        </page>
                        <page string="Absensi Siswa">
                            <field name="attendance_ids">
                                <list>
                                    <field name="schedule_id" />
                                    <field name="teacher_id" />
                                    <field name="student_id" />
                                    <field name="date" />
                                    <field name="status" />
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="student_class_view_kanban" model="ir.ui.view">
        <field name="name">Student Class Kanban View</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <h4><field name="grade" /> <field name="name" /></h4>
                            <div><strong>Wali Murid</strong>     : <field name="teacher_id" /></div>
                            <div><strong>Jurusan</strong>        : <field name="department" /></div>
                            <div><strong>Jumlah Murid</strong>   : <field name="total_student" /></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.actions.act_window" id="student_class_action">
        <field name="name">Classes</field>
        <field name="res_model">student.class</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'group_by': 'grade'}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to Create New Classes
            </p>
        </field>
    </record>

  </data>
</odoo>