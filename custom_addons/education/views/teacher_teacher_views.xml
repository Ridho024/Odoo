<odoo>
    <data>
    
        <record model="ir.ui.view" id="teacher_teacher_list_view">
            <field name="name">Teacher List View</field>
            <field name="model">teacher.teacher</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" optional="show"/>
                    <field name="teacher_image" widget="image" class="o_list_avatar" optional="show"/>
                    <field name="nik" optional="show"/>
                    <field name="gender" optional="show"/>
                    <field name="phone_number" optional="show"/>
                    <field name="email" optional="show"/>

                    <!-- Optional hide -->
                    <field name="birth_date" optional="hide"/>
                    <field name="address" optional="hide"/>
                    <field name="postcal_code" optional="hide"/>
                </list>
            </field>
        </record>
    
        <record model="ir.ui.view" id="teacher_teacher_form_view">
            <field name="name">Teacher Form View</field>
            <field name="model">teacher.teacher</field>
            <field name="arch" type="xml">
                <form string="Teacher Record">
                    <sheet>
                        <group>
                            <group><h1><field name="name" placeholder="Nama" nolabel="0"/></h1></group>
                            <group><field name="teacher_image" widget="image" class="oe_avatar" nolabel="1"/></group>
                        </group>
                        <notebook>
                            <page string="Data Pribadi">
                                <group>
                                    <group>
                                        <field name="nik"/>
                                        <field name="gender"/>
                                        <field name="email"/>
                                        <field name="phone_number"/>
                                    </group>
                                    <group>
                                        <field name="birth_date"/>
                                        <field name="address"/>
                                        <field name="postcal_code"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Riwayat Pendidikan">
                                <field name="education_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="grade"/>
                                        <field name="study_program"/>
                                        <field name="graduation_year"/>
                                        <field name="sertification"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Riwayat Pelatihan">
                                <field name="training_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="institution_name"/>
                                        <field name="training_start_date"/>
                                        <field name="training_end_date"/>
                                        <field name="training_duration"/>
                                        <field name="training_sertificate" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="teacher_teacher_action">
            <field name="name">Teacher</field>
            <field name="res_model">teacher.teacher</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to Create New Teacher
                </p>
            </field>    
        </record>

    </data>
</odoo>