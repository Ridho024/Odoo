<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="classroom_view_tree" model="ir.ui.view">
            <field name="name">classroom.view.list</field>
            <field name="model">classroom.classroom</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="floor"/>
                    <field name="room_number"/>
                    <field name="capacity"/>
                </list>
            </field>
        </record>

        <record id="classroom_view_form" model="ir.ui.view">
            <field name="name">classroom.view.form</field>
            <field name="model">classroom.classroom</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="floor"/>
                            <field name="room_number"/>
                            <field name="capacity"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="classroom_action" model="ir.actions.act_window">
            <field name="name">Classroom</field>
            <field name="res_model">classroom.classroom</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to Create New Classroom
                </p>
            </field>
        </record>
    
    </data>

</odoo>
