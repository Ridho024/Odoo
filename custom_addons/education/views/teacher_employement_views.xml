<odoo>

<data>

    <record id="teacher_employement_view_tree" model="ir.ui.view">
        <field name="name">teacher.employement.view.list</field>
        <field name="model">teacher.employement</field>
        <field name="arch" type="xml">
            <list>
                <field name="nip" optional="show"/>
                <field name="teacher_id" optional="show"/>
                <field name="position" optional="show"/>
                <field name="employement_status" optional="show"/>
                <field name="entry_date" optional="show"/>
                <field name="active_period" optional="show"/>  
            </list>
        </field>
    </record>

    <record id="teacher_employement_view_form" model="ir.ui.view">
        <field name="name">teacher.employement.view.form</field>
        <field name="model">teacher.employement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nip" />
                        <field name="teacher_id" />
                        <field name="position" />
                        <field name="employement_status" />
                        <field name="entry_date" />
                        <field name="active_period" />
                        <field name="basic_salary" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="teacher_employement_action" model="ir.actions.act_window">
        <field name="name">Teacher Employement</field>
        <field name="res_model">teacher.employement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to Create New Teacher Employement
            </p>
        </field>
    </record>

</data>

</odoo>