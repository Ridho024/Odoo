<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    
        <record id="assessment_record_view_list" model="ir.ui.view">
            <field name="name">assessment.view.list</field>
            <field name="model">assessment.record</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" class="fw-bolder"/>
                    <field name="date" optional="hide" />
                    <field name="subject_id"/>
                    <field name="category" widget="badge" />
                    <field name="semester"/>
                    <field name="classroom_id" class="fw-bolder" />
                    <field name="teacher_id" widget="many2one_avatar" />
                </list>
            </field>
        </record>

        <record id="assessment_record_view_form" model="ir.ui.view">
            <field name="name">assessment.record.view.form</field>
            <field name="model">assessment.record</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="subject_id" />
                                <field name="category" />
                                <field name="semester" />
                            </group>
                            <group>
                                <field name="classroom_id" />
                                <field name="teacher_id" />
                                <field name="date" />
                                <field name="total_question" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Criteria Assessment">
                                <field name="assessment_criteria_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="weight" class="fw-bolder"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Results">
                                <field name="assessment_result_ids">
                                    <list editable="bottom">
                                        <field name="student_id" />
                                        <field name="correct_answer" />
                                        <field name="incorrect_answer" />
                                        <field name="score" class="fw bolder" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search -->
        <record id="assessment_record_view_search" model="ir.ui.view">
            <field name="name">assessment.record.view.search</field>
            <field name="model">assessment.record</field>
            <field name="arch" type="xml">
                <search string="Search Students">
                    <field name="name"/>
                    <field name="category"/>
                    <field name="subject_id"/>
                    <field name="classroom_id"/>
                    <group expand="1" string="Group By">
                        <filter string="Classroom" name="group_by_classroom" context="{'group_by':'classroom_id'}"/>
                    </group>
                    <searchpanel>
                        <field name="classroom_id" icon="fa-filter" string="Classroom" select="multi"/>
                        <field name="category" icon="fa-list-ul" t-att-class="text-secondary-emphasis" string="Category" select="multi" />
                        <field name="subject_id" icon="fa-book" string="Subject" select="multi" />
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="assessment_record_action" model="ir.actions.act_window">
            <field name="name">Assessment Record</field>
            <field name="res_model">assessment.record</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create an Assessment</p>
                <p>Click "Create" to add new assessment.</p>
            </field>
        </record>
    
    </data>
</odoo>
