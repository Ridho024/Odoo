<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_student_assessment_record_report_f4" model="report.paperformat">
        <field name="name">Student Assessment Record Report (F4)</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">330</field>
        <field name="page_width">216</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">20</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_student_assessment_record">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Report Assessment Record</h2>
                        <p>Semester: <span t-field="o.semester"/></p>
                        <p>Subject: <span t-field="o.subject_id.name"/></p>
                        <p>Total Question: <span t-field="o.subject_id.name"/></p>
                        <p class="mb-3">
                            Category: 
                            <t t-if="o.category == 'daily_task'">
                                Daily Task
                            </t>
                            <t t-elif="o.category == 'daily_exam'">
                                Daily Exam
                            </t>
                            <t t-elif="o.category == 'midterm_exam'">
                                Midterm Exam
                            </t>
                            <t t-elif="o.category == 'final_exam'">
                                Final Exam
                            </t>
                            <t t-elif="o.category == 'practical_exam'">
                                Practical Exam
                            </t>
                            <t t-else="">
                                Category not identified
                            </t>
                        </p>

                        <h2>Criteria Assessment</h2>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Criteria</th>
                                    <th>Weight</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="assessment_criteria" t-value="o.assessment_criteria_ids"/>
                                <tr t-foreach="assessment_criteria" t-as="criteria">
                                    <td>
                                        <span t-field="criteria.name"/>
                                    </td>
                                    <td>
                                        <span t-field="criteria.weight"/> %
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h2>Student Results</h2>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Correct Answer</th>
                                    <th>Incorrect Answer</th>
                                    <th>Total Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="student_results" t-value="o.assessment_result_ids"/>
                                <tr t-foreach="student_results" t-as="result">
                                    <td>
                                        <span t-field="result.student_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="result.correct_answer"/>
                                    </td>
                                    <td>
                                        <span t-field="result.incorrect_answer"/>
                                    </td>
                                    <td>
                                        <span t-field="result.score"/> %
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_student_assessment_record" model="ir.actions.report">
        <field name="name">Student Assessment Record Report</field>
        <field name="model">education.student.assessment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">education_management.report_student_assessment_record</field>
        <field name="report_file">education_management.report_student_assessment_record</field>
        <field name="print_report_name">'Assessment Report - %s' % object.subject_id.name</field>
        <field name="binding_model_id" ref="model_education_student_assessment"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
