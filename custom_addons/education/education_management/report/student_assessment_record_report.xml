<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_student_assessment_record_report_a4" model="report.paperformat">
        <field name="name">Student Assessment Record Report (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_student_assessment_record">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">

                        <h2 class="text-center" style="text-transform: uppercase; font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 15px;">Student Assessment Report</h2>

                        <div class="row mb-2">
                            <div class="col-6">
                                <strong>Semester:</strong> <span t-field="o.semester"/>
                            </div>
                            <div class="col-6">
                                <strong>Date:</strong> <span t-field="o.date" t-options='{"widget": "date"}'/>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-6">
                                <strong>Subject:</strong> <span t-field="o.subject_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Classroom:</strong> <span t-field="o.classroom_id.name"/>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-6">
                                <strong>Teacher:</strong> <span t-field="o.teacher_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Total Questions:</strong> <span t-field="o.total_question"/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <strong>Category:</strong>
                            <t t-if="o.category == 'daily_task'">Daily Task</t>
                            <t t-elif="o.category == 'daily_exam'">Daily Exam</t>
                            <t t-elif="o.category == 'midterm_exam'">Midterm Exam</t>
                            <t t-elif="o.category == 'final_exam'">Final Exam</t>
                            <t t-elif="o.category == 'practical_exam'">Practical Exam</t>
                            <t t-else="">Category not identified</t>
                        </div>

                        <h4 class="mt-3">Assessment Criteria</h4>
                        <table class="table table-sm table-bordered" style="width: 100%; margin-bottom: 20px;">
                            <thead style="background-color: #f0f0f0;">
                                <tr>
                                    <th style="padding: 5px; width: 70%;">Criteria</th>
                                    <th style="padding: 5px; width: 30%;">Weight (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="assessment_criteria" t-value="o.assessment_criteria_ids"/>
                                <tr t-foreach="assessment_criteria" t-as="criteria">
                                    <td style="padding: 5px; width: 70%;"><span t-field="criteria.name"/></td>
                                    <td style="padding: 5px; text-align: right; width: 30%;"><span t-field="criteria.weight"/>%</td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-3">Student Results</h4>
                        <table class="table table-sm table-bordered" style="width: 100%;">
                            <thead style="background-color: #f0f0f0;">
                                <tr>
                                    <th style="padding: 5px;">Student</th>
                                    <th style="padding: 5px; text-align: center;">Correct Answer</th>
                                    <th style="padding: 5px; text-align: center;">Incorrect Answer</th>
                                    <th style="padding: 5px; text-align: center;">Total Score (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="student_results" t-value="o.assessment_result_ids"/>
                                <tr t-foreach="student_results" t-as="result">
                                    <td style="padding: 5px;"><span t-field="result.student_id.name"/></td>
                                    <td style="padding: 5px; text-align: center;"><span t-field="result.correct_answer"/></td>
                                    <td style="padding: 5px; text-align: center;"><t t-esc="result.assessment_id.total_question - result.correct_answer"/></td>
                                    <td style="padding: 5px; text-align: center;"><t t-esc="'%.2f' % result.score"/>%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_student_assessment_record" model="ir.actions.report">
        <field name="name">Student Assessment Record Report</field>
        <field name="model">education.student.assessment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">education_management.report_student_assessment_record</field>
        <field name="report_file">education_management.report_student_assessment_record</field>
        <field name="print_report_name">'Assessment Report - %s' % object.subject_id.name</field>
        <field name="binding_model_id" ref="model_education_student_assessment"/>
        <field name="paperformat_id" ref="education_management.paperformat_student_assessment_record_report_a4"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
