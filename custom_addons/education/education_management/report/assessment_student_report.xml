<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_student_assessment_report_f4" model="report.paperformat">
        <field name="name">Student Assessment Report (F4)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">330</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_assessment_student">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
    
                        <!-- HEADER -->
                        <div class="text-center mb-3">
                            <h2 style="margin-bottom: 0;">STUDENT ASSESSMENT REPORT</h2>
                            <small style="color: #666;">Academic Performance Summary</small>
                            <hr style="border: 1px solid #000; margin-top: 10px;"/>
                        </div>
    
                        <!-- STUDENT INFO -->
                        <div class="mb-3">
                            <p><strong>Student Name:</strong> <span t-field="o.name"/></p>
                            <p><strong>Teacher Name:</strong> <span t-field="o.classroom_id.teacher_id.name"/></p>
                            <p>
                                <strong>Class:</strong>
                                <t t-if="o.classroom_id.grade == '1'">X</t>
                                <t t-elif="o.classroom_id.grade == '2'">XI</t>
                                <t t-elif="o.classroom_id.grade == '3'">XII</t>
                                <t t-elif="o.classroom_id.grade == '4'">XIII</t>
                                <t t-else="">Unknown</t>
                            </p>
                        </div>
    
                        <!-- ASSESSMENT TABLE -->
                        <t t-foreach="assessment_data.items()" t-as="semester">
                            <h4 style="margin-top: 20px; margin-bottom: 5px;">Semester: <t t-esc="semester[0]"/></h4>
                            
                            <t t-foreach="semester[1].items()" t-as="category">
                                <h5 style="margin-bottom: 5px;">
                                    <strong>Category:</strong> 
                                    <t t-if="category[0] == 'daily_task'">Daily Task</t>
                                    <t t-elif="category[0] == 'daily_exam'">Daily Exam</t>
                                    <t t-elif="category[0] == 'midterm_exam'">Midterm Exam</t>
                                    <t t-elif="category[0] == 'final_exam'">Final Exam</t>
                                    <t t-elif="category[0] == 'practical_exam'">Practical Exam</t>
                                    <t t-else="">Unknown</t>
                                </h5>
    
                                <table class="table table-sm table-bordered" style="width: 100%; font-size: 14px; border-collapse: collapse; margin-bottom: 15px;">
                                    <thead style="background-color: #f0f0f0;">
                                        <tr>
                                            <th style="border: 1px solid #000; padding: 4px;">Subject</th>
                                            <th style="border: 1px solid #000; padding: 4px;">Average Score</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="category[1].items()" t-as="subject">
                                            <tr>
                                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="subject[0]"/></td>
                                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="round(subject[1]['average'], 2)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>
    
                        <!-- FOOTER -->
                        <div class="text-right mt-4" style="margin-top: 30px;">
                            <p>
                                <em>
                                    Printed on:
                                    <t t-if="o.create_date">
                                        <t t-esc="o.create_date.strftime('%d %B %Y')"/>
                                    </t>
                                    <t t-else="">
                                        N/A
                                    </t>
                                </em>
                            </p>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_assessment_student" model="ir.actions.report">
        <field name="name">Student Assessment Report</field>
        <field name="model">education.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">education_management.report_assessment_student</field>
        <field name="report_file">education_management.report_assessment_student</field>
        <field name="paperformat_id" ref="education_management.paperformat_student_assessment_report_f4" />
        <field name="print_report_name">'Assessment Report - %s' % object.name</field>
        <field name="binding_model_id" ref="model_education_student"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
