<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_student_id_card_a4" model="report.paperformat">
        <field name="name">Student ID Card (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_student_id_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="student">
                <div class="page" style="border: 1px solid #000; page-break-after: always; width: 70%; text-align: center; padding: 10px 0px 10px 0px; font-family: Arial, sans-serif;">

                    <!-- Title -->
                    <h2 style="text-transform: uppercase; text-align: center; color: #4B0082; margin-bottom: 5px;">Student ID Card</h2>
                    <hr style="border: 1px solid #4B0082; margin-bottom: 20px; width: 100%;"/>

                    <!-- Two Column Layout -->
                    <div style="display: table; width: 100%;">
                        <!-- Student Photo -->
                        <div style="display: table-cell; width: 35%; text-align: center; vertical-align: top;">
                            <t t-if="student.photo">
                                <img t-att-src="image_data_uri(student.photo)" alt="Student Photo" style="width: 120px; height: 150px; border: 1px solid #999; margin: auto;" />
                            </t>
                            <t t-else="">
                                <div style="width: 120px; height: 150px; border: 1px solid #999; margin: auto; display: flex; align-items: center; justify-content: center; color: #aaa;">
                                    No Photo
                                </div>
                            </t>
                        </div>

                        <!-- Student Info -->
                        <div style="display: table-cell; width: 65%; padding-left: 20px; text-align: left;">
                            <p style="margin: 6px 0;"><strong>NISN:</strong> <t t-esc="student.nisn" /></p>
                            <p style="margin: 6px 0;"><strong>Name:</strong> <t t-esc="student.name" /></p>
                            <p style="margin: 6px 0;"><strong>Gender:</strong> 
                                <t t-if="student.gender == 'male'">Male</t>
                                <t t-if="student.gender == 'female'">Female</t>
                            </p>
                            <p style="margin: 6px 0;"><strong>Email:</strong> <t t-esc="student.email" /></p>
                            <p style="margin: 6px 0;"><strong>Phone:</strong> <t t-esc="student.phone" /></p>
                            <p style="margin: 6px 0;"><strong>Class:</strong> <t t-esc="student.classroom_id.name" /></p>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div style="text-align: right; margin-top: 25px; margin-right: 10px; font-size: 10px; color: #666;">
                        <em>Generated by Odoo - Your School Management System</em>
                    </div>
                    
                </div>
            </t>
        </t>
    </template>


    <record id="action_student_id_card_report" model="ir.actions.report">
        <field name="name">Student ID Card</field>
        <field name="model">education.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">education_management.report_student_id_card_template</field>
        <field name="report_file">education_management.report_student_id_card_template</field>
        <field name="print_report_name">'Student ID Card - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_education_student"/>
        <field name="paperformat_id" ref="education_management.paperformat_student_id_card_a4"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
