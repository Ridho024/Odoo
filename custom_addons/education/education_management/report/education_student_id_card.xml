<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_student_id_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="student">
                <!-- <div class="page">
                    <div style="border:2px solid #000; padding:20px; text-align:center;">
                        <h2 style="color:purple;">Student ID Card</h2>
                        <img t-att-src="image_data_uri(student.photo)" alt="Studen Photo" style="max-width:100px;"/>
                        <p><strong>Name:</strong> <t t-esc="student.name"/></p>
                        <p><strong>Student Number:</strong> <t t-esc="student.nisn"/></p>
                        <p><strong>Issued By:</strong> Ridho024</p>
                    </div>
                </div> -->
                <div class="page" style="border: 2px solid #000; padding: 20px; font-family: Arial, sans-serif;">

                    <!-- Title -->
                    <h2 style="text-align: center; color: #4B0082; margin-bottom: 5px;">Student ID Card</h2>
                    <hr style="border: 1px solid #4B0082;"/>

                    <!-- Two Column Layout -->
                    <div style="display: flex; gap: 30px; margin-top: 20px; align-items: center;">
                        <!-- Student Photo -->
                        <div style="flex: 1; text-align: center;">
                            <img t-att-src="image_data_uri(student.photo)" 
                                 alt="Student Photo"
                                 style="width: 120px; height: 150px; object-fit: cover; border: 1px solid #999;" />
                        </div>

                        <!-- Student Info -->
                        <div style="flex: 2;">
                            <p><strong>NISN:</strong> <t t-esc="student.nisn" /></p>
                            <p><strong>Name:</strong> <t t-esc="student.name" /></p>
                            <p><strong>Gender:</strong> 
                                <t t-if="student.gender == 'male'">Male</t>
                                <t t-if="student.gender == 'female'">Female</t>
                            </p>
                            <p><strong>Email:</strong> <t t-esc="student.email" /></p>
                            <p><strong>Phone:</strong> <t t-esc="student.phone" /></p>
                            <p><strong>Class:</strong> <t t-esc="student.classroom_id.name" /></p>
                        </div>

                    </div>

                    <!-- Optional Footer -->
                    <div style="text-align: right; margin-top: 30px; font-size: 10px; color: #666;">
                        <em>Generated by Odoo - School Management System</em>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_student_id_card_report" model="ir.actions.report">
       <field name="name">Student ID Card</field>
       <field name="model">education.student</field>
       <field name="report_type">qweb-pdf</field>
       <field name="report_name">education_management.report_student_id_card_template</field>
       <field name="report_file">education_management.report_student_id_card_template</field>
       <field name="print_report_name">'Student ID Card - %s' % (object.name)</field>
       <field name="binding_model_id" ref="model_education_student"/>
       <field name="binding_type">report</field>
   </record>

</odoo>
