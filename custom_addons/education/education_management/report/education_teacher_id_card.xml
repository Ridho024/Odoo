<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_teacher_id_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="teacher">
                <div class="page">
                    <div style="border:2px solid #000; padding:20px; text-align:center;">
                        <h2 style="color:purple;">Teacher ID Card</h2>
                        <img t-att-src="image_data_uri(teacher.image_1920)" alt="Teacher Photo" style="max-width:100px;"/>
                        <p><strong>Name:</strong> <t t-esc="teacher.name"/></p>
                        <p><strong>NIP:</strong> <t t-esc="teacher.nip"/></p>
                        <p><strong>Issued By:</strong> Ridho024</p>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_teacher_id_card_report" model="ir.actions.report">
       <field name="name">Teacher ID Card</field>
       <field name="model">res.partner</field>
       <field name="report_type">qweb-pdf</field>
       <field name="report_name">education_management.report_teacher_id_card_template</field>
       <field name="report_file">education_management.report_teacher_id_card_template</field>
       <field name="print_report_name">'Teacher ID Card - %s' % (object.name)</field>
       <field name="binding_model_id" ref="model_res_partner"/>
       <field name="binding_type">report</field>
   </record>

</odoo>
