<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="student_attendance_view_list" model="ir.ui.view">
        <field name="name">student.attendance.view.list</field>
        <field name="model">education.student.attendance</field>
        <field name="arch" type="xml">
            <list string="Students Attendance" editable="bottom">
                <field name="date" />
                <field name="student_id" />
                <field name="nisn" />
                <field name="classroom_id" optional="hide"/>
                <field name="subject_id" />
                <field name="teacher_id" />
                <field name="attendance_status" />
                <field name="absent_reason" invisible="attendance_status != 'absent'"/>
            </list>
        </field>
    </record>

    <record id="student_attendance_view_search" model="ir.ui.view">
        <field name="name">student.attendance.view.search</field>
        <field name="model">education.student.attendance</field>
        <field name="arch" type="xml">
            <search string="Student Class">
                <searchpanel>
                    <field name="classroom_id" string="Classroom" icon="fa-filter" select="multi" />
                    <field name="subject_id" string="Subject" icon="fa-book" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="student_attendance_action" model="ir.actions.act_window">
        <field name="name">Student Attendance</field>
        <field name="res_model">education.student.attendance</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                <strong>No student attendance records found.</strong>
            </p>
            <p>Click "Create" to add new student attendance.</p>
        </field>
    </record>

</odoo>
