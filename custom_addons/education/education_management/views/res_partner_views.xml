<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_inherit_education" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.education</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">17</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group string="Education" invisible="is_company">
                    <group>
                        <field name="gender"/>
                        <field name="is_teacher"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">is_teacher</attribute>
            </xpath>
            <xpath expr="//notebook//page[@name='accounting']" position="attributes">
                <attribute name="invisible">is_teacher</attribute>
            </xpath>
            <xpath expr="//notebook//page[@name='internal_notes']" position="before">
                <page string="Education Management" name="education" invisible="not is_teacher">
                    <group>
                        <group string='Studies'>
                            <field name="major_ids" widget="many2many_tags"/>
                            <field name="class_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Administration">
                            <field name="nip" />
                        </group>
                    </group>
                </page>
                <page string="Attendance Record" name="attendance_record" invisible="not is_teacher">
                    <field name="attendance_ids">
                        <list create="false">
                            <field name="date" class="fw bolder" />
                            <field name="classroom_id" />
                            <field name="subject_id" />
                            <field name="absent" sum="Absent"/>
                            <field name="present" sum="Present" />
                            <field name="absent_alpha" sum="Alpha" />
                            <field name="absent_sick" sum="Sick" />
                            <field name="absent_permit" sum="Permit" />
                        </list>
                    </field>
                    <footer>
                        <div>
                            <strong>Total absent per month:</strong><field name="total_absent" /><br/>
                            <strong>Total present per month</strong><field name="total_present" /><br/>
                            <strong>Total alpha per month:</strong><field name="total_absent_alpha" /><br/>
                            <strong>Total sick per month:</strong><field name="total_absent_sick" /><br/>
                            <strong>Total permit per month:</strong><field name="total_absent_permit" /><br/>
                        </div>
                    </footer>
                </page>
            </xpath>
        </field>
    </record>

    <record id="education_teacher_action" model="ir.actions.act_window">
        <field name="name">Teachers List</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_teacher', '=', True)]</field>
        <field name="context">{'default_is_teacher': True}</field>
    </record>


</odoo>
