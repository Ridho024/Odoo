<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="education_classroom_view_list" model="ir.ui.view">
        <field name="name">education.classroom.view.list</field>
        <field name="model">education.classroom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" class="fw-bolder" />
                <field name="code" widget="badge" /> 
                <field name="grade" widget="badge" decoration-danger="grade == '1'" decoration-warning="grade == '2'" decoration-success="grade == '3' or grade == '4'" />
                <field name="major_id" class="fw-bolder" />
                <field name="teacher_id" widget="many2one_avatar" />  
                <field name="capacity" widget="badge" optional="hide" />
            </list>
        </field>
    </record>

    <record id="education_classroom_view_form" model="ir.ui.view">
        <field name="name">education.classroom.view.form</field>
        <field name="model">education.classroom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="capacity" />
                            <field name="teacher_id" widget="many2one_avatar"/>
                        </group>
                        <group>
                            <field name="grade" />
                            <field name="active" />
                            <field name="major_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="name" class="fw-bolder" />
                                    <field name="id_student" class="fw-bolder" />
                                    <field name="gender" />
                                    <field name="email" />
                                    <field name="phone" />
                                    <field name="photo" widget="image" class="o_list_avatar" />
                                    <field name="date_of_birth" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page string="Schedules">
                            <field name="schedule_ids">
                                <list>
                                    <field name="subject_id" class="fw-bolder" />
                                    <field name="teacher_id" widget="many2one_avatar" />
                                    <field name="day_of_week" />
                                    <field name="start_time" />
                                    <field name="end_time" />
                                    <field name="duration" class="fw-bolder" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="education_classroom_view_search" model="ir.ui.view">
        <field name="name">education.classroom.view.search</field>
        <field name="model">education.classroom</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="teacher_id" />
                <field name="major_id" />
                <group expand="1" string="Group By">
                    <filter string="Grade" name="group_by_grade" context="{'group_by':'grade'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="education_classroom_action" model="ir.actions.act_window">
        <field name="name">Classroom</field>
        <field name="res_model">education.classroom</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">
            {'search_default_group_by_grade': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a classroom</p>
            <p>Click "Create" to add new classroom.</p>
        </field>
    </record>

</odoo>
