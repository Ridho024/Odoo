<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="education_teacher_schedules_view_list" model="ir.ui.view">
        <field name="name">education.teacher.schedules.view.list</field>
        <field name="model">education.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="course_id" />
                <field name="classroom_id" />
                <field name="teacher_id" />
                <field name="day_of_week" />
                <field name="start_time" />
                <field name="end_time" />
                <field name="notes" optional="hide" />
            </list>
        </field>
    </record>

    <record id="education_teacher_schedules_view_form" model="ir.ui.view">
        <field name="name">education.teacher.schedules.view.form</field>
        <field name="model">education.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="course_id" />
                            <field name="classroom_id" />
                            <field name="teacher_id" />
                            <field name="day_of_week" />
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="duration" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="education_teacher_schedules_action" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">education.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Add new schedules here.</p>
        </field>
    </record>

</odoo>
