<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    
        <!-- LIST VIEW -->
        <record id="education_student_assessment_view_list" model="ir.ui.view">
            <field name="name">assessment.view.list</field>
            <field name="model">education.student.assessment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="subject_id" class="fw-bolder"/>
                    <field name="category" widget="badge" />
                    <field name="semester"/>
                    <field name="teacher_id" widget="many2one_avatar" />
                    <field name="date" class="fw-bolder" optional="show" />
                    <field name="classroom_id" class="fw-bolder" optional="hide"/>
                    <field name="passing_score" optional="hide"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" class="text-center"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="education_student_assessment_view_form" model="ir.ui.view">
            <field name="name">assessment.record.view.form</field>
            <field name="model">education.student.assessment</field>
            <field name="arch" type="xml">
                <form string="Student Assessment" class="o_form_nospace">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state == 'done'"/>
                        <button name="action_reset" type="object" string="Reset to Draft" class="btn-secondary" invisible="state == 'draft'"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="subject_id" />
                                <field name="classroom_id" />
                                <field name="category" />
                                <field name="semester" />
                            </group>
                            <group>
                                <field name="teacher_id" />
                                <field name="date" />
                                <field name="total_question" />
                                <field name="passing_score"/>
                                <field name="assessment_file" widget="attachment" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Criteria Assessment">
                                <field name="assessment_criteria_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="weight" class="fw-bolder"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Results">
                                <field name="assessment_result_ids">
                                    <list editable="bottom">
                                        <field name="student_id" />
                                        <field name="correct_answer" />
                                        <field name="score" class="fw-bolder" />
                                        <field name="is_passed" widget="boolean_toggle" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="education_student_assessment_view_search" model="ir.ui.view">
            <field name="name">assessment.record.view.search</field>
            <field name="model">education.student.assessment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="category"/>
                    <field name="subject_id"/>
                    <field name="classroom_id"/>
                    <field name="state"/>
                    <group expand="1" string="Group By">
                        <filter string="Classroom" name="group_by_classroom" context="{'group_by':'classroom_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                    <searchpanel>
                        <field name="classroom_id" icon="fa-filter" string="Classroom" select="multi"/>
                        <field name="category" icon="fa-list-ul" string="Category" select="multi" />
                        <field name="subject_id" icon="fa-book" string="Subject" select="multi" />
                        <field name="state" icon="fa-circle-check" string="Status" select="multi"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="education_student_assessment_action" model="ir.actions.act_window">
            <field name="name">Assessment Record</field>
            <field name="res_model">education.student.assessment</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_by_classroom': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create an Assessment</p>
                <p>Click "Create" to add new assessment.</p>
            </field>
        </record>
    
    </data>
</odoo>
