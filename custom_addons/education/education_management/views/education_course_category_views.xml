<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="education_course_category_view_tree" model="ir.ui.view">
        <field name="name">education.course.category.view.tree</field>
        <field name="model">education.course.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="active" />
                <field name="description" optional="hide" />
            </list>
        </field>
    </record>

    <record id="education_course_category_view_form" model="ir.ui.view">
        <field name="name">education.course.category.view.form</field>
        <field name="model">education.course.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description" widget="text"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Subcategories">
                            <field name="child_ids">
                                <list>
                                    <field name="name" />
                                    <field name="code" />
                                </list>
                            </field>
                        </page>
                        <page name="course_ids">
                            <field name="course_ids">
                                <list>
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="teacher_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="education_course_category_action" model="ir.actions.act_window">
        <field name="name">Course Category</field>
        <field name="res_model">education.course.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Add new course category</p>
        </field>
    </record>

</odoo>
