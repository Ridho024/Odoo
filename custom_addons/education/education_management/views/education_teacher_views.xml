<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="education_teacher_view_list" model="ir.ui.view">
        <field name="name">education.teacher.view.list</field>
        <field name="model">education.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="photo" widget="image" />
                <field name="id_teacher"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="date_of_birth" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="education_teacher_view_form" model="ir.ui.view">
        <field name="name">education.teacher.view.form</field>
        <field name="model">education.teacher</field>
        <field name="arch" type="xml">
            <form string="Student Form">
                <header>
                    <field name="status" widget="statusbar" options="{'statusbar_visible': ['active', 'retired', 'resigned']}"/>
                </header>
                <sheet>
                    <group>
                        <group><h1><field name="name" placeholder="Name" nolabel="1" /></h1></group>
                        <group><field name="photo" widget="image" class="oe_avatar" nolabel="1" /></group>
                    </group>
                    <group>
                        <group>
                            <field name="id_teacher"/>
                            <field name="gender" />
                            <field name="date_of_birth"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="academic_and_subjects" string="Academic and Subjects">
                            <group>
                                <field name="subject_ids" widget="many2many_tags" options="{'color_field': 'color'}" class="mb-3"/>
                                <field name="class_ids" widget="many2many_tags" options="{'color_field': 'color'}" class="mb-3"/>
                            </group>
                        </page>
                        <page name="attendance" string="Attendance">
                            <field name="attendance_ids">
                                <list>
                                    <field name="date" />
                                    <field name="teacher_id" />
                                    <field name="course_id" />
                                    <field name="classroom_id" />
                                    <field name="status" />
                                </list>
                            </field>
                        </page>
                        <page name="administration" string="Administrations">
                            <group>
                                <field name="employement_date" />
                                <field name="salary" />
                                <field name="currency_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="education_teacher_action" model="ir.actions.act_window">
        <field name="name">Teacher List</field>
        <field name="res_model">education.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Create teacher record here.</p>
        </field>
    </record>

</odoo>
