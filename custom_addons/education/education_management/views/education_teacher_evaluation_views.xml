<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    
        <record id="education_teacher_evaluation_view_list" model="ir.ui.view">
            <field name="name">teacher.evaluation.view.list</field>
            <field name="model">education.teacher.evaluation</field>
            <field name="arch" type="xml">
                <list> 
                    <field name="name" class="fw-bolder" />
                    <field name="teacher_id" widget="many2one_avatar" />
                    <field name="evaluator_id" widget="many2one_avatar" />
                    <field name="date" />
                    <field name="total_score" widget="badge" decoration-success="total_score >= 80" decoration-warning="total_score >= 70 and total_score &lt; 80" decoration-danger="total_score &lt; 70 or total_score == False" />
                </list> 
            </field>
        </record>

        <record id="education_teacher_evaluation_view_form" model="ir.ui.view">
            <field name="name">teacher.evaluation.view.form</field>
            <field name="model">education.teacher.evaluation</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="teacher_id" />
                                <field name="evaluator_id" />
                                <field name="date" />
                            </group>
                            <group>
                                <field name="total_score" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Results">
                                <field name="evaluation_result_ids">
                                    <list editable="bottom">
                                        <field name="criteria_id" />
                                        <field name="score" />
                                    </list>
                                </field>
                            </page>
                            <page string="Feedback">
                                <field name="feedback_ids">
                                    <list editable="bottom">
                                        <field name="feedback_text" />
                                        <field name="improvement_text" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="education_teacher_evaluation_view_search" model="ir.ui.view">
            <field name="name">teacher.evaluation.view.search</field>
            <field name="model">education.teacher.evaluation</field>
            <field name="arch" type="xml">
                <search>
                    <group expand="1" string="Group By">
                        <filter string="Teacher" name="group_by_teacher_id" context="{'group_by':'teacher_id'}"/>
                        <filter string="Month" name="group_by_date_month" context="{'group_by':'date:month'}" />
                    </group>
                    <searchpanel>
                        <field name="teacher_id" icon="fa-user" string="Teacher" select="multi" />
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="education_teacher_evaluation_action" model="ir.actions.act_window">
            <field name="name">Teacher Evaluation</field>
            <field name="res_model">education.teacher.evaluation</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">
                {
                    'search_default_group_by_teacher_id': True,
                    'search_default_group_by_date_month': True
                }
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create an Evaluation</p>
                <p>Click "Create" to add new teacher evaluation.</p>
            </field>
        </record>
    </data>
</odoo>
