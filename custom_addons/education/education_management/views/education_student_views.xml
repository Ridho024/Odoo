<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="education_student_view_list" model="ir.ui.view">
        <field name="name">education.student.view.list</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <list>
                <field name='sequence' widget='handle'/>
                <field name="id_student" class="fw-bolder" />
                <field name="nisn" class="fw-bolder" />
                <field name="name" />
                <field name="gender" optional="hide"/>
                <field name="email" />
                <field name="classroom_id" widget="badge" />
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'dropout'" decoration-primary="status == 'graduated'"/>
                <button string="Attendance" name="action_create_attendance" type="object" class="oe_highlight"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="education_student_view_form" model="ir.ui.view">
        <field name="name">education.student.view.form</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <form string="Student Form">
                <header>
                    <field name="status" widget="statusbar" options="{'statusbar_visible': ['draft', 'active', 'graduated', 'dropout']}"/>
                    <button string="Create ID Card" name="action_create_student_card" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group><h1><field name="name" placeholder="Name" nolabel="1" /></h1></group>
                        <group><field name="photo" widget="image" class="oe_avatar" nolabel="1" /></group>
                    </group>
                    <group>
                        <group>
                            <field name="gender" />
                            <field name="id_student"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group> 
                        <group>
                            <field name="date_of_birth"/>
                            <field name="classroom_id" options="{'no_create': true}"/>
                            <field name="nisn" />
                        </group>
                    </group>
                    <notebook>
                        <page name="parents" string="Parents">
                            <group>
                                <group string="Student's Father">
                                    <field name="father_name" />
                                    <field name="father_contact" />
                                    <field name="father_email" />
                                </group>
                                <group string="Student's Mother">
                                    <field name="mother_name" />
                                    <field name="mother_contact" />
                                    <field name="mother_email" />
                                </group>
                            </group>
                        </page>
                        <page name="student_achievement" string="Achievements">
                            <field name="achievement_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="sertificate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="education_student_view_kanban" model="ir.ui.view">
        <field name="name">education.student.view.kanban</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <kanban default_group_by="classroom_id"
                    quick_create="False">
                <field name="status"/>
                <field name="classroom_id"/>
                <field name="date_of_birth"/>
                <field name="photo"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="row">
                               <div class="col-3">
                                    <div class="o_kanban_image">
                                        <field name="photo" widget="image" class="fixed-image" />
                                    </div>
                               </div>
                               <div class="col-9">
                                    <h5 class="mb-0"><field name="name"/></h5>
                                    <div>
                                        <field name="email"/>
                                        <i class="fa fa-envelope-o ms-2" title="email"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bolder">Status: </span>
                                        <span><field name="status"/></span>
                                    </div>
                               </div>
                            </div>
                        </div>
                    </t>
                </templates>
           </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="education_student_view_search" model="ir.ui.view">
        <field name="name">education.student.view.search</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="name"/>
                <field name="nisn"/>
                <field name="phone"/>
                <field name="email"/>
                <filter name="filter_gender_male" string="Male" domain="[('gender', '=', 'male')]" />
                <filter name="filter_gender_female" string="Female" domain="[('gender', '=', 'female')]" />
                <field name="classroom_id"/>
                <group expand="1" string="Group By">
                    <filter string="Classroom" name="group_by_classroom" context="{'group_by':'classroom_id'}"/>
                </group>
                <searchpanel>
                    <field name="classroom_id" icon="fa-filter" string="Classroom" select="multi"/>
                    <field name="status" icon="fa-dot-circle-o" string="Status" select="multi" />
                    <field name="gender" icon="fa-user" string="Gender" select="multi" />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="education_student_action" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">education.student</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">
            {'search_default_group_by_classroom': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a student</p>
            <p>Click "Create" to add new student.</p>
        </field>
    </record>

</odoo>
