<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="education_course_view_list" model="ir.ui.view">
        <field name="name">education.courses.view.list</field>
        <field name="model">education.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="duration" />
                <field name="teacher_id" />
                <field name="category_id" />
            </list>
        </field>
    </record>

    <record id="education_course_view_form" model="ir.ui.view">
        <field name="name">education.course.view.form</field>
        <field name="model">education.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />      
                        <field name="code" />
                        <field name="teacher_id" />  
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" />
                        </page>
                        <page string="Schedules">
                            <field name="schedule_ids">
                                <list>
                                    <field name="course_id" />
                                    <field name="classroom_id" />
                                    <field name="teacher_id" />
                                    <field name="day_of_week" />
                                    <field name="start_time" />
                                    <field name="end_time" />
                                    <field name="duration" />
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="education_course_action" model="ir.actions.act_window">
        <field name="name">Course</field>
        <field name="res_model">education.course</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Add new course record</p>
        </field>
    </record>

</odoo>
