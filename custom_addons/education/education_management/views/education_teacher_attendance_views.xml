<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="teacher_attendance_view_list" model="ir.ui.view">
        <field name="name">teacher.attendance.view.tree</field>
        <field name="model">education.teacher.attendance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date" />
                <field name="teacher_id" />
                <field name="course_id" />
                <field name="classroom_id" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="teacher_attendance_view_search" model="ir.ui.view">
        <field name="name">teacher.attendance.view.search</field>
        <field name="model">education.teacher.attendance</field>
        <field name="arch" type="xml">
            <search string="Teacher Class">
                <searchpanel>
                    <field name="classroom_id" string="Classroom" enable_counter="1" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="teacher_attendance_action" model="ir.actions.act_window">
        <field name="name">Teacher Attendance</field>
        <field name="res_model">education.teacher.attendance</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Add new teacher in teacher list.</p>
        </field>
    </record>

</odoo>
