<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="teacher_attendance_view_list" model="ir.ui.view">
        <field name="name">teacher.attendance.view.tree</field>
        <field name="model">education.teacher.attendance</field>
        <field name="arch" type="xml">
            <list string="Teachers Attendance" editable="bottom">
                <field name="date" />
                <field name="teacher_id" />
                <field name="nip" />
                <field name="classroom_id" />
                <field name="subject_id" />
                <field name="attendance_status" />
                <field name="absent_reason" invisible="attendance_status != 'absent'" />
            </list>
        </field>
    </record>

    <record id="teacher_attendance_view_search" model="ir.ui.view">
        <field name="name">teacher.attendance.view.search</field>
        <field name="model">education.teacher.attendance</field>
        <field name="arch" type="xml">
            <search string="Teacher Class">
                <searchpanel>
                    <field name="classroom_id" string="Classroom" icon="fa-filter" select="multi" />
                    <field name="subject_id" string="Subject" icon="fa-book" select="multi" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="teacher_attendance_action" model="ir.actions.act_window">
        <field name="name">Teacher Attendance</field>
        <field name="res_model">education.teacher.attendance</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a teacher attendance</p>
            <p>Click "Create" to add new teacher attendance.</p>
        </field>
    </record>

</odoo>
