<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Education Management Category -->
        <record id="module_category_education_management" model="ir.module.category">
            <field name="name">Education Management</field>
            <field name="sequence">20</field>
            <field name="description">Access rights related to the Education Management module.</field>
        </record>
    
        <!-- Groups -->
        <record id="group_education_teacher" model="res.groups">
            <field name="name">Teacher</field>
            <field name="category_id" ref="education_management.module_category_education_management"/>
        </record>

        <record id="group_education_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="category_id" ref="education_management.module_category_education_management"/>
            <field name="implied_ids" eval="[(4, ref('education_management.group_education_teacher'))]" />
        </record>

        <!-- Record Rule -->
        <record id="restrict_access_teacher" model="ir.rule">
            <field name="name">Teacher cannot create teacher record</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="groups" eval="[(4, ref('education_management.group_education_teacher'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
