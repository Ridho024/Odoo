<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    
        <record id="monthly_attendance_compute" model="ir.cron">
            <field name="name">Monthly Attendances</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.compute_monthly_attendance()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d 00:00:00')"/>
            <field name="priority" >1</field>
        </record>
    
    </data>
</odoo>
