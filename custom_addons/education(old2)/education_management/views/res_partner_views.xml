<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_inherit_education" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.education</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">17</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_id_pkp']" position="after">
                <field name="gender"/>
                <field name="is_teacher"/>
            </xpath>
            <xpath expr="//notebook//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">is_teacher</attribute>
            </xpath>
            <xpath expr="//notebook//page[@name='accounting']" position="attributes">
                <attribute name="invisible">is_teacher</attribute>
            </xpath>
            <xpath expr="//notebook//page[@name='internal_notes']" position="before">
                <page string="Education Management" name="education" invisible="not is_teacher">
                    <group>
                        <group string='Classes'>
                            <field name="major_ids" widget="many2many_tags"/>
                            <field name="class_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Administration">
                            <field name="nip" />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//button[@name='action_view_sale_order']" position="attributes">
                <attribute name="invisible">is_teacher</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_partner_invoices']" position="attributes">
                <attribute name="invisible">is_teacher</attribute>
            </xpath>
            <xpath expr="//div[@class='o_row']" position="attributes">
                <attribute name="invisible">is_teacher</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button string="Create ID Card" name="action_create_teacher_card" type="object" class="oe_highlight" invisible="not is_teacher"/>
                    <button string="Create Teacher User" name="action_create_teacher_user" type="object" class="oe_stat_button" invisible="not is_teacher and teacher_login_id" />
                </header>
            </xpath>
        </field>
    </record>

    <record id="education_teacher_action" model="ir.actions.act_window">
        <field name="name">Teachers List</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_teacher', '=', True)]</field>
        <field name="context">{'default_is_teacher': True}</field>
    </record>

</odoo>
