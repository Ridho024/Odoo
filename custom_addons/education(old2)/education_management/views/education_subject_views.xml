<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="education_subject_view_list" model="ir.ui.view">
        <field name="name">education.subject.view.list</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" class="fw-bolder"/>
                <field name="code" class="fw-bolder"/>
                <field name="teacher_id" widget="many2one_avatar"/>
            </list>
        </field>
    </record>

    <record id="education_subject_view_form" model="ir.ui.view">
        <field name="name">education.subject.view.form</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                       <field name="name" /> 
                       <field name="code" /> 
                       <field name="teacher_id" widget="many2one_avatar" /> 
                       <field name="teacher_ids" widget="many2many_tags" /> 
                    </group>
                    <notebook>
                        <page name="subject_ids" string="Subject Details">
                            <field name="subject_ids">
                                <list editable="bottom">
                                    <field name="curriculum_id" />
                                    <field name="studies" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="education_subject_action" model="ir.actions.act_window">
        <field name="name">Subject</field>
        <field name="res_model">education.subject</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a subject</p>
            <p>Click "Create" to add new subject.</p>
        </field>
    </record>

</odoo>
